  DoorwayStoolBlock("<b>DoorwayStoolBlock</b><br/>Room 2 — blocks/warns the player from carrying the stool out through a doorway.")
  DrawerClue("<b>DrawerClue</b><br/>Room 1 Clue 2 setup (Triangle) — opens the drawer, reveals the paper inside.")
  EndMenu("<b>EndMenu</b><br/>Win/loss screen — Retry Room (keep progress) or Play Again (fresh game).")
  FirstPersonController("<b>FirstPersonController</b><br/>Player movement + mouse look; exposes SetInputEnabled() so UI overlays can pause it.")
  GameState("<b>GameState</b><br/>Static cross-scene game state — per-room codes, solved rooms, checkpoints, win/loss.")
  GrazingLightReveal("<b>GrazingLightReveal</b><br/>Reveals a surface only under a close, shallow-angle light graze (Room 3's nameplate).")
  ImmediateRoomEntry("<b>ImmediateRoomEntry</b><br/>Room 1's 'already inside at spawn' substitute for RoomEntryTrigger.")
  InspectionLamp("<b>InspectionLamp</b><br/>Room 3+ handheld spotlight, toggled with F — follows wherever the player looks.")
  InspectionLampCradle("<b>InspectionLampCradle</b><br/>Room 3 — assembles the inspection lamp from two carried parts.")
  Inventory("<b>Inventory</b><br/>Bottom-center held-item row (max 4) — puzzle objects auto-use whatever item they need.")
  InventoryPickup("<b>InventoryPickup</b><br/>Generic world pickup — E adds it to the inventory and hides it.")
  KeypadController("<b>KeypadController</b><br/>World-space keypad prop — E opens its KeypadUI panel.")
  KeypadDigitButton("<b>KeypadDigitButton</b><br/>UI button wrapper — forwards a digit press to its KeypadUI.")
  KeypadUI("<b>KeypadUI</b><br/>Shared exit keypad (Room 1 + Room 2) — checks a guess, slides the door open.")
  LightSwitchClue("<b>LightSwitchClue</b><br/>Room 1 Clue 4 (Bar) — toggles a light; the clue text is only readable while it's off.")
  MainBreaker("<b>MainBreaker</b><br/>Room 3 — checks all 4 breakers against the nameplate pattern, opens the door or penalizes.")
  MovableCabinetClue("<b>MovableCabinetClue</b><br/>Room 1 Clue 1 (Circle) — slides the displaced cabinet back, reveals hidden wall text.")
  NameplateArrows("<b>NameplateArrows</b><br/>Fills Room 3's nameplate arrows from the random breaker target pattern.")
  ObjectiveToast("<b>ObjectiveToast</b><br/>Top-center fade-in room objective line; Tab replays it.")
  PaperCloseupClue("<b>PaperCloseupClue</b><br/>Room 1 Clue 2 (Triangle) — opens the paper close-up, marks the clue seen.")
  PaperCloseupUI("<b>PaperCloseupUI</b><br/>Full-screen paper-reading overlay for Room 1's Triangle clue.")
  PlayerInteractor("<b>PlayerInteractor</b><br/>Raycasts for interactables each frame and routes E / Tab / F input to them.")
  Room2CodeValidator("<b>Room2CodeValidator</b><br/>Room 2's exit-code check against GameState.")
  RoomEntryTrigger("<b>RoomEntryTrigger</b><br/>First-entry doorway trigger — starts the room timer, sets the save checkpoint, shows the objective toast.")
  RoomExitTrigger("<b>RoomExitTrigger</b><br/>Marks a room solved on exit; the final one ends the game in victory.")
  RoomTimer("<b>RoomTimer</b><br/>Per-room silent countdown — flicker, sequential light shutoff, blackout loss.")
  SlideMover("<b>SlideMover</b><br/>Generic smooth local-position slide, reused by doors/drawers/cabinets.")
